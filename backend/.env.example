# Copy to .env and adjust. Every value has a dev-safe default in config.py.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# SQLite (default, zero setup) or Postgres:
# DATABASE_URL=postgresql+asyncpg://orbita:orbita@localhost:5432/orbita
DATABASE_URL=sqlite+aiosqlite:///./orbita.db

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# Seed a demo workspace on first boot (disable in production)
SEED_DEMO_DATA=true
