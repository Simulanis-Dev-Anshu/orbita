# Copy to .env and adjust. Every value has a dev-safe default in config.py.

SECRET_KEY=dev-orbita-change-me-32bytes-minimum-hex

# MongoDB Atlas. Leave <db_password> in the URI and set MONGODB_PASSWORD,
# or paste a full URI that already includes the password.
MONGODB_URI=mongodb+srv://anshunishadhamptons_db_user:<db_password>@job-automation.es2fo8i.mongodb.net/?appName=job-automation
MONGODB_DB=orbita
MONGODB_PASSWORD=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

SEED_DEMO_DATA=true
ALLOW_PUBLIC_READ=true
DEMO_EMAIL=anshu@orbita.com
DEMO_PASSWORD=orbita-demo-123

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Optional live OAuth. Leave blank to import JSON / run a sample scan instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
