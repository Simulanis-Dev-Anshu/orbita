# Copy to .env and adjust. Every value has a dev-safe default in config.py.

SECRET_KEY=dev-orbita-change-me-32bytes-minimum-hex
DATABASE_URL=sqlite+aiosqlite:///./orbita.db
# Postgres (optional): docker compose up -d postgres
# DATABASE_URL=postgresql+asyncpg://orbita:orbita@localhost:5432/orbita

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

SEED_DEMO_DATA=true
ALLOW_PUBLIC_READ=true
DEMO_EMAIL=anshu@orbita.com
DEMO_PASSWORD=orbita-demo-123
